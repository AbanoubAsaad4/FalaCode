spring.application.name=falacode

# Database Setup
# Replace placeholders with your actual PostgreSQL configuration or set environment variables
spring.datasource.url=jdbc:postgresql://localhost:5432/falacode
spring.datasource.username=${DB_USERNAME:your_db_user_here}
spring.datasource.password=${DB_PASSWORD:your_db_password_here}

# JPA / Hibernate Configurations
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true